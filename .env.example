# Copy to .env in the directory you run shilp from, and adjust.
# Real environment variables always win over this file. Point SHILP_ENV_FILE
# at a different path to read one from elsewhere.

# Where models, manifests and telemetry live. Default: ~/.shilp
# SHILP_HOME=/Users/you/.shilp

# A llama.cpp checkout — needed only for convert and quantize, not for serving.
# git clone https://github.com/ggml-org/llama.cpp ~/llama.cpp
# SHILP_LLAMACPP_DIR=/Users/you/llama.cpp

# Token for gated repos (Llama, Gemma). Never commit a real value.
# HF_TOKEN=hf_...

# Server bind address. 127.0.0.1 by default because there is no authentication.
# SHILP_HOST=127.0.0.1
# SHILP_PORT=8000

# Models kept in memory at once. 1 is right for a laptop.
# SHILP_MAX_RESIDENT=1

# llamacpp | fake. `fake` runs the whole HTTP surface with no model.
# SHILP_ENGINE=llamacpp

# Threads for llama.cpp. 0 lets the engine choose (physical cores).
# SHILP_THREADS=0
